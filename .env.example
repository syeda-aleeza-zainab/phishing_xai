# Environment variables for phishing_xai (template — fill in YOUR OWN keys)
# Copy to .env and never commit .env to Git.

# Gemini API key for BEC email generation
# (experiments/modern_phishing_ood/datasets/yoadjei_bec/generate_emails.py)
# Get yours free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Azure AI Foundry (Frontiers corpus generation scripts)
# (experiments/modern_phishing_ood/datasets/zenodo_frontiers/code/config.py)
AZURE_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_API_KEY=your_azure_api_key_here
